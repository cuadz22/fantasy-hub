{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/yahoo/:p",
      "destination": "/api/yahoo-:p"
    },
    {
      "source": "/s/:id",
      "destination": "/api/s?id=:id"
    },
    {
      "source": "/i/:id",
      "destination": "/api/simg?id=:id"
    },
    {
      "source": "/road/:lg",
      "destination": "/road/:lg.html"
    },
    {
      "source": "/((?!api/)(?!.*\\.html$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/cfn.html",
      "permanent": false
    }
  ]
}