{
  "redirects": [
    {
      "source": "/",
      "destination": "/cfn.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/yahoo/:p",
      "destination": "/api/yahoo-:p"
    },
    {
      "source": "/((?!api/)(?!.*\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}