{
  "redirects": [
    {
      "source": "/",
      "destination": "/redesign/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/mobile/:p*",
      "destination": "/api/mobile?r=:p*"
    },
    {
      "source": "/api/yahoo/:p",
      "destination": "/api/yahoo-:p"
    },
    {
      "source": "/s/:id",
      "destination": "/api/s?id=:id"
    },
    {
      "source": "/i/:id",
      "destination": "/api/simg?id=:id"
    },
    {
      "source": "/road/:lg",
      "destination": "/road/:lg.html"
    },
    {
      "source": "/exposure",
      "destination": "/exposure.html"
    },
    {
      "source": "/((?!api/)(?!.*\\.html$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/hw?snap=1",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/mobile/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mobile/cron-lineups?lg=gl",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mobile/cron-lineups?lg=bh",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mobile/cron-lineups?lg=rb",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mobile/cron-lineups?lg=sts",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mobile/cron-ball",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mobile/cron-maintenance",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/mobile/cron-portraits",
      "schedule": "23 */6 * * *"
    },
    {
      "path": "/api/mobile/cron-push",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mobile/cron-network",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mobile/cron-connected",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mobile/cron-cantcut",
      "schedule": "0 10,22 * * *"
    },
    {
      "path": "/api/mobile/cron-trades",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/mobile/cron-market",
      "schedule": "7,37 * * * *"
    },
    {
      "path": "/api/mobile/cron-activities",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/mobile/cron-recaps",
      "schedule": "*/15 10-23 * * 2"
    }
  ],
  "functions": {
    "api/mobile.js": {
      "maxDuration": 60
    }
  }
}
