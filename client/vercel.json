{
  "redirects": [
    {
      "source": "/",
      "destination": "/cfn.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/mobile/:p*",
      "destination": "/api/mobile?r=:p*"
    },
    {
      "source": "/api/yahoo/:p",
      "destination": "/api/yahoo-:p"
    },
    {
      "source": "/s/:id",
      "destination": "/api/s?id=:id"
    },
    {
      "source": "/i/:id",
      "destination": "/api/simg?id=:id"
    },
    {
      "source": "/road/:lg",
      "destination": "/road/:lg.html"
    },
    {
      "source": "/exposure",
      "destination": "/exposure.html"
    },
    {
      "source": "/((?!api/)(?!.*\\.html$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/hw?snap=1",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/mobile/cron",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/mobile.js": {
      "maxDuration": 60
    }
  }
}